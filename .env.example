# Copy to .env.local and fill in. Never commit real values.

# Firebase service-account JSON, base64-encoded (used by /api/upload)
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Storage bucket name, e.g. my-project.appspot.com
FIREBASE_STORAGE_BUCKET=

# Apps Script web app deployment URL, ending in /exec (used by /api/save-inventory)
GOOGLE_SCRIPT_URL=
